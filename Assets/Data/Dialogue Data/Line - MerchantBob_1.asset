  m_Script: {fileID: 11500000, guid: 59d8a5b69fe50e74a86d57021af5634c, type: 3}
  m_Name: Line - MerchantBob_1
  m_EditorClassIdentifier: 
  dialogueGroupName: Merchant Bob
  speaker: {fileID: 11400000, guid: ca34c7dbd73516c4f88685ff4da95a71, type: 2}
  textLine:
  - "Nói nhanh lên nào, nếu lâu hơn một hớp bia thì ta bận lắm đấy nhé!"
  - "A, gặp lại bạn cũ thật tốt - dù trông cậu vẫn như vừa dứt sữa ấy. Cần mua bán gì nào?"
  - "Lão thợ rèn Joe lại cuỗm mất đồ nghề của ta rồi. Ta thề có ngày ta chôn sống lão..."
  - "Làm hỏng là phải đền tiền đấy nhé! Còn nếu ta làm vỡ... à thì, đó là truyền thống rồi!"
  actionLine: 
  actionType: 5
